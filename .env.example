# ---------------------------------------------------------------------------
# Shared local app settings
# ---------------------------------------------------------------------------

# Local development uses SQLite. Production should use DATABASE_URL/PostgreSQL.
CREATOR_ANALYTICS_DB_PATH=data/creator_analytics.db

# Optional production database/cache URLs for the FastAPI API and workers.
DATABASE_URL=postgresql://creator_user:creator_password@localhost:5432/creator_analytics
REDIS_URL=redis://localhost:6379/0

# API/frontend local URLs.
API_HOST=127.0.0.1
API_PORT=8000
FRONTEND_ORIGIN=http://127.0.0.1:5173
VITE_API_BASE_URL=http://127.0.0.1:8000

# ---------------------------------------------------------------------------
# TikTok OAuth and ingestion
# Active today: used by services/worker-tiktok and scripts/run_pipeline.py.
# ---------------------------------------------------------------------------

TIKTOK_CLIENT_KEY=your_tiktok_client_key
TIKTOK_CLIENT_SECRET=your_tiktok_client_secret
TIKTOK_REDIRECT_URI=http://localhost:8080/callback
TIKTOK_SCOPES=user.info.basic,video.list
TIKTOK_DISABLE_AUTO_AUTH=0
TIKTOK_OPEN_BROWSER=true
TIKTOK_CALLBACK_TIMEOUT_SECONDS=180
TIKTOK_TOKEN_PATH=tiktok_tokens.json

# TikTok pipeline settings.
# TIKTOK_DB_PATH defaults to CREATOR_ANALYTICS_DB_PATH when omitted.
TIKTOK_DB_PATH=data/creator_analytics.db
TIKTOK_VIDEO_PAGE_LIMIT=5
TIKTOK_VIDEO_PAGE_SIZE=20
TIKTOK_REFRESH_BUFFER_SECONDS=300
TIKTOK_SCHEDULE_TIME=03:30

# Legacy built-in TikTok HTML dashboard settings.
DASHBOARD_HOST=127.0.0.1
DASHBOARD_PORT=8050

# ---------------------------------------------------------------------------
# YouTube / Google OAuth and APIs
# Active for services/worker-youtube and scripts/run_youtube_pipeline.py.
# The current worker uses YOUTUBE_API_KEY + YOUTUBE_CHANNEL_ID for public
# channel video statistics. OAuth values are included for private analytics.
# ---------------------------------------------------------------------------

GOOGLE_CLIENT_ID=your_google_oauth_client_id
GOOGLE_CLIENT_SECRET=your_google_oauth_client_secret
GOOGLE_REDIRECT_URI=http://localhost:8081/callback
GOOGLE_PROJECT_ID=your_google_cloud_project_id
GOOGLE_APPLICATION_CREDENTIALS=path/to/google-service-account.json

YOUTUBE_API_KEY=your_youtube_data_api_key
YOUTUBE_CHANNEL_ID=your_youtube_channel_id
YOUTUBE_SCOPES=https://www.googleapis.com/auth/youtube.readonly,https://www.googleapis.com/auth/yt-analytics.readonly
YOUTUBE_TOKEN_PATH=youtube_tokens.json
YOUTUBE_VIDEO_PAGE_SIZE=50
YOUTUBE_VIDEO_PAGE_LIMIT=10

# ---------------------------------------------------------------------------
# Instagram / Meta OAuth and Graph API
# Active for services/worker-instagram and scripts/run_instagram_pipeline.py.
# ---------------------------------------------------------------------------

META_APP_ID=your_meta_app_id
META_APP_SECRET=your_meta_app_secret
META_GRAPH_VERSION=v20.0
META_REDIRECT_URI=http://localhost:8082/callback
META_SCOPES=instagram_basic,instagram_manage_insights,pages_show_list,pages_read_engagement

INSTAGRAM_BUSINESS_ACCOUNT_ID=your_instagram_business_account_id
INSTAGRAM_PAGE_ID=your_facebook_page_id_connected_to_instagram
INSTAGRAM_ACCESS_TOKEN=your_long_lived_instagram_or_page_access_token
INSTAGRAM_TOKEN_PATH=instagram_tokens.json
INSTAGRAM_MEDIA_PAGE_SIZE=50
INSTAGRAM_MEDIA_PAGE_LIMIT=10

# ---------------------------------------------------------------------------
# AWS deployment and queue infrastructure
# Reserved for Lambda/ECS/SQS/RDS deployment.
# ---------------------------------------------------------------------------

AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your_aws_access_key_id
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key
AWS_SESSION_TOKEN=

SQS_QUEUE_URL=https://sqs.us-east-1.amazonaws.com/123456789012/creator-analytics-jobs
SQS_QUEUE_NAME=creator-analytics-jobs
S3_FRONTEND_BUCKET=creator-analytics-frontend
RDS_SECRET_ARN=arn:aws:secretsmanager:us-east-1:123456789012:secret:creator-analytics-db
REDIS_ENDPOINT=localhost:6379

# ---------------------------------------------------------------------------
# Alerts and analytics thresholds
# ---------------------------------------------------------------------------

ALERT_MIN_TOTAL_VIEWS=100
ALERT_GROWTH_DROP_PERCENT=30
VIRAL_VIEW_GROWTH_PERCENT=200
TOP_CONTENT_LIMIT=25
